# Copy this to profiles.yml (gitignored) and fill in real values,
# or set the SNOWFLAKE_* env vars and reference them with env_var().
event_driven_pipeline:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: TRANSFORMER
      database: EVENTDRIVEN_PIPELINE_DB
      warehouse: EVENTDRIVEN_PIPELINE_WH
      schema: ANALYTICS
      threads: 4
